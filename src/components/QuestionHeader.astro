---
/**
 * La pregunta es la puerta de entrada (Charter §2, §11.2): grande, en serif, y antes que cualquier dato.
 * El identificador va en mono (única función de esa familia junto con hashes y cotas).
 */
interface Props {
  kicker: string;
  moduleId: string;
  id: string;
  question: string;
  canonical: string;
}
const { kicker, moduleId, id, question, canonical } = Astro.props;
---

<header class="qh">
  <p class="qh__k">
    {kicker}{" "}
    <span class="mono" data-num="id">
      {moduleId} / {id}
    </span>
  </p>
  <h1 class="qh__h" data-canonical={canonical}>
    {question}
  </h1>
</header>

<style>
  .qh {
    padding-block: var(--space-8) var(--space-7);
  }
  .qh__k {
    font: 500 var(--fs-label) / 1.4 var(--sans);
    color: var(--graphite);
    display: flex;
    gap: var(--space-3);
    align-items: baseline;
    flex-wrap: wrap;
  }
  .qh__h {
    margin-top: var(--space-5);
    font: 300 var(--fs-question) / var(--lh-tight) var(--serif);
    letter-spacing: -0.018em;
    text-wrap: balance;
    max-width: 24ch;
  }
</style>
