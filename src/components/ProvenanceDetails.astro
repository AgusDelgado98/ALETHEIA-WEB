---
import type { QuestionView } from "../lib/view.ts";
import SegmentText from "./SegmentText.astro";
/**
 * Procedencia y auditoría, en profundidad y nunca primero (Charter §9). Progressive disclosure con <details>:
 * cerrado por defecto, operable con teclado y sin JavaScript. Identificadores y hashes van en mono.
 */
interface Props {
  v: QuestionView;
}
const { v } = Astro.props;
const ui = v.ui;
const p = v.provenance;
const ids = p.entityIds;
---

<section class="prov" aria-labelledby="prov-h">
  <div class="wrap">
    <details class="prov__d">
      <summary id="prov-h" class="prov__s">
        {ui("provenance_summary")}
      </summary>
      <div class="prov__b">
        <p class="prov__i">{ui("provenance_intro")}</p>
        <dl class="prov__l">
          <div>
            <dt>{ui("prov_module")}</dt>
            <dd class="mono">
              {v.moduleId} <span data-num="id">{p.moduleVersion}</span>
            </dd>
          </div>
          <div>
            <dt>{ui("prov_tag")}</dt>
            <dd class="mono">
              <span data-num="hash">{p.tag}</span>
            </dd>
          </div>
          <div>
            <dt>{ui("prov_commit")}</dt>
            <dd class="mono">
              <span data-num="hash">{p.commit}</span>
            </dd>
          </div>
          <div>
            <dt>{ui("prov_manifest")}</dt>
            <dd class="mono">
              <span data-num="hash">{p.manifestSha}</span>
            </dd>
          </div>
          <div>
            <dt>{ui("prov_editorial")}</dt>
            <dd class="mono">
              <span data-num="hash">{p.editorialSha}</span>
            </dd>
          </div>
          <div>
            <dt>{ui("prov_ids")}</dt>
            <dd class="mono ids">
              {ids.map((x) => (
                <span data-num="id">{x}</span>
              ))}
            </dd>
          </div>
          <div>
            <dt>{ui("prov_canonical_question")}</dt>
            <dd class="prov__c" lang="en">
              {v.canonicalQuestion}
            </dd>
          </div>
          <div>
            <dt>{ui("prov_disclosure")}</dt>
            <dd>
              {p.disclosure !== null ? (
                <SegmentText parts={p.disclosure} />
              ) : p.disclosureRequired ? (
                ""
              ) : (
                ui("prov_disclosure_none")
              )}
            </dd>
          </div>
          <div>
            <dt>{ui("prov_cite")}</dt>
            <dd class="prov__c">
              <SegmentText parts={p.cite} />
            </dd>
          </div>
          {p.pendingSignoff > 0 && (
            <div>
              <dt>{ui("prov_pending_signoff")}</dt>
              <dd class="mono">
                <span data-num="count">{p.pendingSignoff}</span>
              </dd>
            </div>
          )}
        </dl>
      </div>
    </details>
  </div>
</section>

<style>
  .prov {
    padding-block: var(--space-8) var(--space-9);
  }
  .prov__d {
    border-top: var(--rule) solid var(--hair);
    border-bottom: var(--rule) solid var(--hair);
  }
  .prov__s {
    cursor: pointer;
    padding: var(--space-5) 0;
    font: 400 var(--fs-serif-sm) / var(--lh-serif) var(--serif);
    list-style-position: outside;
  }
  .prov__s:hover {
    color: var(--verd-deep);
  }
  .prov__b {
    padding-bottom: var(--space-6);
  }
  .prov__i {
    font: 400 var(--fs-small) / var(--lh-body) var(--sans);
    color: var(--graphite);
    max-width: var(--measure-prose);
    margin-bottom: var(--space-5);
  }
  .prov__l {
    display: grid;
    gap: var(--space-4);
    max-width: 52rem;
  }
  .prov__l > div {
    display: grid;
    grid-template-columns: minmax(10rem, 14rem) minmax(0, 1fr);
    column-gap: var(--space-5);
    align-items: baseline;
  }
  dt {
    font: 500 var(--fs-label) / var(--lh-body) var(--sans);
    color: var(--graphite);
  }
  dd {
    margin: 0;
    font: 400 var(--fs-small) / var(--lh-body) var(--sans);
    overflow-wrap: anywhere;
  }
  .ids {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1) var(--space-4);
  }
  .prov__c {
    max-width: var(--measure-prose);
  }
  @media (max-width: 40rem) {
    .prov__l > div {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
