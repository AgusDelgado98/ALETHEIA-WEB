---
import type { TextItem } from "../lib/view.ts";
import { splitFirstSentence } from "../lib/render.ts";
import Glyph from "./Glyph.astro";
import SegmentText from "./SegmentText.astro";
/**
 * «Lo que esto NO significa» (Charter §11.1): nace en el corte del hilo. Cada límite es una frase concreta con
 * su razón en gris, en el mismo párrafo, marcada con el glifo de Límite (que siempre lleva su texto al lado).
 */
interface Props {
  heading: string;
  items: TextItem[];
}
const { heading, items } = Astro.props;
---

<section class="no" aria-labelledby="not-h">
  <h2 id="not-h" class="no__h">
    {heading}
  </h2>
  <ul class="no__l">
    {items.map((it) => {
      const s = splitFirstSentence(it.parts);
      return (
        <li id={`not-${it.id}`}>
          <Glyph kind="limit" size="1.5rem" />
          <p>
            <span class="no__m">
              <SegmentText parts={s.main} />
            </span>
            {s.reason.length > 0 && (
              <>
                {" "}
                <span class="no__r">
                  <SegmentText parts={s.reason} />
                </span>
              </>
            )}
          </p>
        </li>
      );
    })}
  </ul>
</section>

<style>
  .no__h {
    font: 300 var(--fs-serif-xl) / var(--lh-tight) var(--serif);
    letter-spacing: -0.014em;
    margin-bottom: var(--space-6);
  }
  .no__l {
    display: grid;
    gap: var(--space-5);
  }
  .no__l li {
    display: grid;
    grid-template-columns: 1.5rem minmax(0, 1fr);
    column-gap: var(--space-4);
    align-items: baseline;
  }
  .no__l :global(.g) {
    align-self: start;
    margin-top: 0.15em;
    color: var(--ink);
  }
  .no__l p {
    font: 400 var(--fs-serif-sm) / var(--lh-serif) var(--serif);
    letter-spacing: -0.006em;
    max-width: 42ch;
  }
  .no__r {
    color: var(--graphite);
  }
</style>
