---
import type { QuestionView, TrailView } from "../lib/view.ts";
import EvidenceState from "./EvidenceState.astro";
import Glyph from "./Glyph.astro";
import SegmentText from "./SegmentText.astro";
/**
 * El Rastro (Charter §11.3): núcleo VERTICAL, leído de la respuesta al origen:
 * afirmación → hipótesis → CORTE → evidencia → objeto → fuente.
 * Arriba del corte, lo no alcanzado (punteado, glifos huecos o discontinuos); abajo, lo sostenido (sólido).
 * El corte es semántico además de visual: es un ítem de la lista con su propio texto.
 * Tres profundidades (Resumen → Detalle → Auditoría) con radios y CSS: sin JavaScript.
 */
interface Props {
  v: QuestionView;
  trail?: TrailView;
  prefix?: string;
}
const { v, trail, prefix = "" } = Astro.props;
const ui = v.ui;
const t = trail ?? v.trail;
if (t === null) throw new Error("EvidenceTrail: no hay Rastro de claim");
const observed = t.claimState === "OBSERVED_IN_SOURCE";
const refuted = t.claimState === "REFUTED_WITHIN_SCOPE";
const held = observed || refuted;
const showCut = t.reasons.length > 0;
const shapeDesc =
  t.claimState === "INSUFFICIENT_EVIDENCE"
    ? ui("shape_insufficient")
    : observed
      ? ui("shape_observed")
      : refuted
        ? ui("shape_refuted")
        : ui("layer_question");
const hid = `${prefix}trail-h`;
const d1 = `${prefix}depth-1`;
const d2 = `${prefix}depth-2`;
const d3 = `${prefix}depth-3`;
const depthName = prefix === "" ? "rastro-depth" : `rastro-depth-${prefix.replace(/-$/, "")}`;
---

<section
  class="rastro"
  aria-labelledby={hid}
  data-state={t.claimState}
  data-claim-id={t.claimId}
  data-claim-state={t.claimState}
>
  <div class="wrap rastro__in">
    <div class="rastro__head">
      <h2 id={hid} class="rastro__h">
        {ui("trail_heading")}
        {v.trails.length > 1 && (
          <>
            {" "}
            <span class="mono" data-num="id">
              {t.claimId}
            </span>
          </>
        )}
      </h2>
      <p class="rastro__dir">{ui("trail_direction")}</p>
      <fieldset class="seg">
        <legend class="sr-only">{ui("depth_group")}</legend>
        <span class="seg__o">
          <input class="sr-only" type="radio" name={depthName} id={d1} value="1" checked />
          <label for={d1}>{ui("depth_summary")}</label>
        </span>
        <span class="seg__o">
          <input class="sr-only" type="radio" name={depthName} id={d2} value="2" />
          <label for={d2}>{ui("depth_detail")}</label>
        </span>
        <span class="seg__o">
          <input class="sr-only" type="radio" name={depthName} id={d3} value="3" />
          <label for={d3}>{ui("depth_audit")}</label>
        </span>
      </fieldset>
      <div class="key d2">
        <h3 class="key__h">{ui("legend_heading")}</h3>
        <ul class="key__l">
          <li>
            <Glyph kind="source" size="0.8rem" /> {ui("node_source")}
          </li>
          <li>
            <Glyph kind="object" size="0.8rem" /> {ui("node_object")}
          </li>
          <li>
            <Glyph kind="evidence" size="0.8rem" /> {ui("node_evidence")}
          </li>
          <li>
            <Glyph kind="hypothesis" fill="ghost" size="0.8rem" /> {ui("node_hypothesis")}
          </li>
          <li>
            <Glyph kind="claim" fill="hollow" size="0.8rem" /> {ui("node_claim")}
          </li>
          <li>
            <Glyph kind="limit" size="0.8rem" /> {ui("node_limit")}
          </li>
        </ul>
        <p class="key__n">{ui("trail_legend_note")}</p>
      </div>
    </div>

    <ol class="core">
      <li class:list={["cn", "cn--claim", { "cn--ghost": !held }]}>
        <span class="cn__g">
          <Glyph
            kind="claim"
            fill={observed ? "solid" : refuted ? "ghost" : "hollow"}
            size="1.375rem"
          />
        </span>
        <div class="cn__b">
          <p class="cn__k">{ui("node_claim")}</p>
          <p class="cn__p">
            <SegmentText parts={t.claim} />
          </p>
          <p class="cn__st d2">
            <EvidenceState state={t.claimState} label={t.claimLabel} description={shapeDesc} />
          </p>
        </div>
        <div class="cn__s d2">
          {v.state.absenceNotNegative && <p class="cn__d">{v.absenceText}</p>}
        </div>
        <p class="cn__m d3 mono">
          <span data-num="id">{t.ids.claim}</span>
        </p>
      </li>

      <li class:list={["cn", "cn--hyp", { "cn--ghost": !held, "cn--to-cut": showCut }]}>
        <span class="cn__g">
          <Glyph kind="hypothesis" fill={held ? "solid" : "ghost"} size="1.375rem" />
        </span>
        <div class="cn__b">
          <p class="cn__k">{ui("node_hypothesis")}</p>
          <p class="cn__p">
            <SegmentText parts={t.hypothesis} />
          </p>
        </div>
        <div class="cn__s d2"></div>
        <p class="cn__m d3 mono">
          <span data-num="id">{t.ids.hypothesis}</span>
        </p>
      </li>

      {showCut && (
        <li class="cn cn--cut" data-node="cut">
          <div class="cut">
            <p class="cut__t">
              <span class="cut__slot" aria-hidden="true">
                <Glyph kind="limit" size="1.5rem" />
              </span>
              <span class="cut__k">{ui("cut_label")}.</span> {ui("cut_title")}
            </p>
            <p class="cut__l">
              {ui("cut_above")} {ui("cut_below")}
            </p>
            <div class="cut__r d2">
              <h3 class="cut__rh">{ui("cut_reasons")}</h3>
              <ul>
                {t.reasons.map((r) => (
                  <li>
                    <SegmentText parts={r.parts} />
                  </li>
                ))}
              </ul>
            </div>
          </div>
        </li>
      )}

      <li class="cn cn--ev">
        <span class="cn__g">
          <Glyph kind="evidence" size="1.375rem" />
        </span>
        <div class="cn__b">
          <p class="cn__k">{ui("node_evidence")}</p>
          <p class="cn__p">
            <SegmentText parts={t.evidence} />
          </p>
        </div>
        <div class="cn__s d2"></div>
        <p class="cn__m d3 mono">
          {t.ids.evidence.map((id) => (
            <span data-num="id">{id}</span>
          ))}
        </p>
      </li>

      <li class="cn cn--obj">
        <span class="cn__g">
          <Glyph kind="object" size="1.375rem" />
        </span>
        <div class="cn__b">
          <p class="cn__k">{ui("node_object")}</p>
          {t.objects.map((o) => (
            <p class="cn__p">
              <SegmentText parts={o.parts} />
            </p>
          ))}
        </div>
        <div class="cn__s d2"></div>
        <p class="cn__m d3 mono">
          {t.objects.map((o) => (
            <span data-num="id">{o.id}</span>
          ))}
        </p>
      </li>

      <li class="cn cn--src">
        <span class="cn__g">
          <Glyph kind="source" size="1.375rem" />
        </span>
        <div class="cn__b">
          <p class="cn__k">{ui("node_source")}</p>
          <p class="cn__p">
            <SegmentText parts={t.source.publication} />
          </p>
        </div>
        <div class="cn__s d2">
          {t.source.linkUnresolved && <p class="cn__d">{ui("source_link_unresolved")}</p>}
        </div>
        <p class="cn__m d3 mono">
          <span data-num="id">{t.source.rootId}</span>
        </p>
      </li>
    </ol>

    {t.auditOnly.length > 0 && (
      <div class="audit d3">
        <h3 class="audit__h">{ui("prov_limits_audit")}</h3>
        <ul class="audit__l">
          {t.auditOnly.map((a) => (
            <li>
              <p class="audit__o mono">
                <span data-num="id">{a.ownerId}</span>
              </p>
              <p class="audit__t">
                <SegmentText parts={a.text} />
              </p>
              <p class="audit__w">{a.waiver}</p>
            </li>
          ))}
        </ul>
      </div>
    )}
  </div>
</section>

<style is:global>
  /* El Rastro usa el fondo de banda del Charter; los glifos huecos se rellenan con él. */
  .rastro {
    --sect-bg: var(--paper-2);
    background: var(--sect-bg);
    padding-block: var(--space-9) var(--space-7);
  }
  .rastro__head {
    display: grid;
    gap: var(--space-4);
    max-width: 44rem;
    margin-bottom: var(--space-7);
  }
  .rastro__h {
    font: 300 var(--fs-serif-xl) / var(--lh-tight) var(--serif);
    letter-spacing: -0.014em;
  }
  .rastro__dir {
    font: 400 var(--fs-base) / var(--lh-body) var(--sans);
    color: var(--graphite);
  }

  /* profundidad: Resumen (silencio) → Detalle (límites, notas, leyenda) → Auditoría (identificadores en mono) */
  .rastro .d2,
  .rastro .d3 {
    display: none;
  }
  .rastro:has(input[value="2"]:checked) .d2,
  .rastro:has(input[value="3"]:checked) .d2,
  .rastro:has(input[value="3"]:checked) .d3 {
    display: var(--show, block);
  }

  .seg {
    border: var(--rule) solid var(--hair-2);
    border-radius: 2px;
    display: inline-flex;
    width: fit-content;
    padding: 0;
    margin: 0;
  }
  .seg__o + .seg__o {
    border-left: var(--rule) solid var(--hair-2);
  }
  .seg label {
    display: block;
    font: 400 var(--fs-small) / 1 var(--sans);
    color: var(--graphite);
    padding: var(--space-3) var(--space-4);
    min-height: 2.75rem;
    display: flex;
    align-items: center;
    cursor: pointer;
    border-bottom: 2px solid transparent;
  }
  .seg label:hover {
    color: var(--ink);
  }
  /* control activo = verdigris (Charter §10: «elemento actualmente activo») */
  .rastro:has(input[value="1"]:checked) label[for$="depth-1"],
  .rastro:has(input[value="2"]:checked) label[for$="depth-2"],
  .rastro:has(input[value="3"]:checked) label[for$="depth-3"] {
    color: var(--ink);
    border-bottom-color: var(--verd);
  }
  .seg input:focus-visible + label {
    outline: var(--focus);
    outline-offset: var(--focus-offset);
  }

  .key__h {
    font: 500 var(--fs-label) / 1.4 var(--sans);
    color: var(--graphite);
  }
  .key__l {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-5);
    margin-top: var(--space-3);
    font: 400 var(--fs-label) / 1 var(--sans);
    color: var(--graphite);
  }
  .key__l li {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
  }
  .key__l .g {
    color: var(--ink);
  }
  .key__n {
    margin-top: var(--space-3);
    font: 400 var(--fs-label) / var(--lh-body) var(--sans);
    color: var(--graphite);
  }

  /* núcleo vertical */
  .core {
    max-width: 48rem;
  }
  .cn {
    position: relative;
    display: grid;
    grid-template-columns: 2.75rem minmax(0, 1fr);
    column-gap: var(--space-5);
    padding-bottom: var(--space-7);
  }
  .cn__g {
    position: relative;
    z-index: 1;
    display: flex;
    justify-content: center;
    align-items: flex-start;
    height: 1.625rem;
    background: var(--sect-bg);
    color: var(--ink);
  }
  .cn--ghost .cn__g {
    color: var(--graphite);
  }
  .cn__b {
    grid-column: 2;
  }
  .cn__s,
  .cn__m {
    grid-column: 2;
  }
  .cn__k {
    font: 500 var(--fs-label) / 1.625rem var(--sans);
    color: var(--graphite);
  }
  .cn__p {
    margin-top: 2px;
    font: 400 var(--fs-serif-sm) / var(--lh-serif) var(--serif);
    letter-spacing: -0.006em;
    max-width: 44ch;
  }
  .cn--ghost .cn__p {
    color: var(--graphite);
  }
  .cn__st {
    margin-top: var(--space-3);
  }
  .cn__d {
    margin-top: var(--space-3);
    font: 400 var(--fs-label) / var(--lh-body) var(--sans);
    color: var(--graphite);
    max-width: 44ch;
  }
  .cn__m {
    --show: flex;
    margin-top: var(--space-3);
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-4);
    color: var(--graphite);
  }
  /* el hilo entre glifos: sólido = sostenido; punteado = enunciado o esperado, no alcanzado */
  .cn::before {
    content: "";
    position: absolute;
    left: 1.34rem;
    top: 0.85rem;
    bottom: -0.85rem;
    border-left: var(--rule) solid var(--ink);
  }
  .cn--ghost::before {
    border-left: var(--rule) dotted var(--graphite);
  }
  .cn--hyp.cn--to-cut::before {
    bottom: 0; /* el hilo llega hasta el corte y termina */
  }
  .cn--src::before,
  .cn--cut::before {
    display: none;
  }

  /* el corte: misma geometría que la ranura de la Apertura, pero en TINTA (expresa un estado, no una acción) */
  .cn--cut {
    display: block;
    padding-bottom: var(--space-6);
  }
  .cut {
    position: relative;
    margin-left: -0.5rem;
    border-top: var(--rule) solid var(--ink);
    border-bottom: var(--rule) solid var(--ink);
    background: var(--ink-tint);
    padding: var(--space-5) var(--space-5) var(--space-5) 3.5rem;
  }
  .cut__slot {
    position: absolute;
    left: 0.75rem;
    top: var(--space-4);
    color: var(--ink);
  }
  .cut__t {
    font: 300 var(--fs-serif-md) / var(--lh-serif) var(--serif);
    letter-spacing: -0.008em;
  }
  .cut__k {
    font-weight: 500;
  }
  .cut__l {
    margin-top: var(--space-2);
    font: 400 var(--fs-small) / var(--lh-body) var(--sans);
    color: var(--graphite);
  }
  .cut__rh {
    margin-top: var(--space-4);
    font: 500 var(--fs-label) / 1.4 var(--sans);
    color: var(--graphite);
  }
  .cut__r ul {
    margin-top: var(--space-2);
    display: grid;
    gap: var(--space-3);
  }
  .cut__r li {
    font: 400 var(--fs-small) / var(--lh-body) var(--sans);
    max-width: var(--measure-prose);
  }

  .audit {
    margin-top: var(--space-6);
    max-width: 48rem;
  }
  .audit__h {
    font: 500 var(--fs-label) / 1.4 var(--sans);
    color: var(--graphite);
  }
  .audit__l {
    margin-top: var(--space-3);
    display: grid;
    gap: var(--space-4);
    border-top: var(--rule) solid var(--hair-2);
    padding-top: var(--space-4);
  }
  .audit__o {
    color: var(--graphite);
  }
  .audit__t {
    margin-top: var(--space-1);
    font: 400 var(--fs-small) / var(--lh-body) var(--sans);
    max-width: var(--measure-prose);
  }
  .audit__w {
    margin-top: var(--space-1);
    font: 400 var(--fs-label) / var(--lh-body) var(--sans);
    color: var(--graphite);
    max-width: var(--measure-prose);
  }
</style>
