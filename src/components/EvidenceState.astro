---
/**
 * Estado epistemológico por GEOMETRÍA, relleno y corte; nunca solo por color (Charter §8, §15.1).
 * INSUFICIENTE: hilo sólido → corte → hilo punteado → ■ hueco.
 * NO IDENTIFICABLE (resolución de pregunta, no estado de claim): zona rayada, sin ■.
 * Solo se implementan las formas que las páginas publicadas necesitan; las demás exigen auditar su descripción accesible.
 */
interface Props {
  state: "INSUFFICIENT_EVIDENCE" | "NOT_IDENTIFIABLE";
  label: string;
  description: string;
}
const { state, label, description } = Astro.props;
---

<span class="state" data-state={state}>
  {state === "INSUFFICIENT_EVIDENCE" && (
    <svg class="state__shape" viewBox="0 0 168 24" role="img" aria-label={description}>
      <line class="thread" x1="2" y1="12" x2="58" y2="12"></line>
      <path class="cut" d="M62 3v18M72 3v18"></path>
      <line class="dots" x1="78" y1="12" x2="140" y2="12"></line>
      <rect class="sq" x="146" y="5" width="14" height="14"></rect>
    </svg>
  )}
  {state === "NOT_IDENTIFIABLE" && (
    <svg class="state__shape" viewBox="0 0 168 24" role="img" aria-label={description}>
      <defs>
        <pattern
          id="ni-hatch"
          width="6"
          height="6"
          patternUnits="userSpaceOnUse"
          patternTransform="rotate(45)"
        >
          <line x1="0" y1="0" x2="0" y2="6" stroke="currentColor" stroke-width="1.4"></line>
        </pattern>
      </defs>
      <rect class="hatch" x="2" y="4" width="164" height="16" fill="url(#ni-hatch)"></rect>
    </svg>
  )}
  <span class="state__label">{label}</span>
</span>

<style>
  .state {
    display: inline-flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2) var(--space-3);
    max-width: 100%;
  }
  .state__shape {
    width: 10.5rem;
    height: 1.5rem;
    flex: none;
    overflow: visible;
    color: var(--ink);
  }
  .thread,
  .cut {
    stroke: currentColor;
    stroke-width: 1.4;
    fill: none;
  }
  .dots {
    stroke: var(--graphite);
    stroke-width: 1.4;
    stroke-dasharray: 1.5 4;
    stroke-linecap: butt;
  }
  .sq {
    fill: var(--sect-bg);
    stroke: currentColor;
    stroke-width: 1.4;
  }
  .hatch {
    stroke: currentColor;
    stroke-width: 1.4;
  }
  .state__label {
    font: 500 var(--fs-small) / 1.2 var(--sans);
    color: var(--graphite);
  }
</style>
