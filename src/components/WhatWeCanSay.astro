---
import type { TextItem } from "../lib/view.ts";
import SegmentText from "./SegmentText.astro";
/** «Lo que sí podemos decir» (Charter §11.1): título fijo; solo afirmaciones que sostiene el claim. */
interface Props {
  heading: string;
  items: TextItem[];
}
const { heading, items } = Astro.props;
---

<section class="say" aria-labelledby="say-h">
  <h2 id="say-h" class="say__h">
    {heading}
  </h2>
  <ul class="say__l">
    {items.map((it) => (
      <li id={`say-${it.id}`}>
        <SegmentText parts={it.parts} />
      </li>
    ))}
  </ul>
</section>

<style>
  .say__h {
    font: 500 var(--fs-label) / 1.4 var(--sans);
    color: var(--graphite);
    margin-bottom: var(--space-5);
  }
  .say__l {
    display: grid;
    gap: var(--space-5);
  }
  .say__l li {
    font: 300 var(--fs-serif-md) / var(--lh-serif) var(--serif);
    letter-spacing: var(--tracking-serif);
    max-width: var(--measure-serif);
    text-wrap: pretty;
  }
</style>
