---
import "../../design/tokens.css";
import "../styles/global.css";
import SiteFooter from "../components/SiteFooter.astro";
import SiteNav from "../components/SiteNav.astro";
import { SITE_ORIGIN } from "../lib/origin.ts";
import { loadSite } from "../lib/site.ts";
interface Props {
  title: string;
  description: string;
  skip?: string;
  wordmark?: string;
  ogType?: string;
  ogDescription?: string;
  robots?: string;
}
const site = loadSite(process.cwd());
const ui = site.ui;
const { title, description } = Astro.props;
const skip = Astro.props.skip ?? ui("skip_link");
const wordmark = Astro.props.wordmark ?? ui("brand_wordmark");
const ogType = Astro.props.ogType ?? "website";
const ogDescription = Astro.props.ogDescription ?? description;
const robots = Astro.props.robots;
const current = Astro.url.pathname.replace(/\/index\.html$/, "/").replace(/\.html$/, "");
const path = current === "" ? "/" : current;
const canonical = path === "/" ? SITE_ORIGIN : `${SITE_ORIGIN}${path}`;
const ogUrl = /[0-9]/.test(path) ? undefined : canonical;
---

<!doctype html>
<html lang="es-AR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {robots !== undefined && <meta name="robots" content={robots} />}
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={ogDescription} />
    {ogUrl !== undefined && <meta property="og:url" content={ogUrl} />}
    <meta property="og:locale" content="es_AR" />
    <meta property="og:site_name" content={ui("brand_wordmark")} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={ogDescription} />
    <link
      rel="preload"
      href="/fonts/newsreader-latin-wght.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/instrument-sans-latin-wght.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
  </head>
  <body>
    <a class="skip" href="#contenido">
      {skip}
    </a>
    <SiteNav ui={ui} wordmark={wordmark} current={current} />
    <main id="contenido" tabindex="-1">
      <slot />
    </main>
    <SiteFooter ui={ui} tag={site.pin.tag} commitShort={site.pin.commitShort} />
  </body>
</html>

<style is:global>
  /* Wordmark (Charter §12): serif 500, tracking amplio y LA RANURA a media altura de las mayúsculas */
  .wordmark {
    position: relative;
    display: inline-block;
    font: 500 1.0625rem / 1 var(--serif);
    letter-spacing: var(--tracking-wordmark);
    padding-right: 0.24em;
    color: var(--ink);
  }
  .wordmark::after {
    content: "";
    position: absolute;
    left: -3px;
    right: -1px;
    top: calc(50% - 0.27em);
    height: max(1.5px, 0.09em);
    background: var(--paper);
  }
  main:focus {
    outline: none;
  }
</style>
