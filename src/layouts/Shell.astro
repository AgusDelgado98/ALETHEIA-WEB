---
import "../../design/tokens.css";
import "../styles/global.css";
import "../styles/shell.css";
import ShellBar from "../components/ShellBar.astro";
import StatusBar from "../components/StatusBar.astro";
import { loadSite } from "../lib/site.ts";
import Head from "./Head.astro";
/**
 * Shell REGISTRO + FOLIO (prototipo). Cuadrícula de viewport en escritorio (≥ 64 rem y ≥ 34 rem de alto);
 * por debajo degrada a documento normal: Registro → Folio. Sin JavaScript.
 * `view="registro"` (Registro + carátula), `view="folio"` (Registro + Folio de una pregunta) o `view="doc"`
 * (Registro + panel de documento: Explorar, Hallazgos, Límites, Método, Versiones, Sobre).
 */
interface Props {
  title: string;
  description: string;
  ogDescription?: string;
  robots?: string;
  view: "registro" | "folio" | "doc";
}
const site = loadSite(process.cwd());
const ui = site.ui;
const { title, description, ogDescription, robots, view } = Astro.props;
---

<!doctype html>
<html lang="es-AR">
  <Head
    title={title}
    description={description}
    siteName={ui("brand_wordmark")}
    ogDescription={ogDescription}
    robots={robots}
  />
  <body class="shell" data-view={view}>
    <a class="skip" href="#contenido">
      {ui("skip_link")}
    </a>
    <ShellBar ui={ui} tag={site.pin.tag} />
    <div class="stage">
      <slot name="registro" />
      <main id="contenido" class="folio-wrap" tabindex="-1">
        <slot />
      </main>
    </div>
    <StatusBar ui={ui} tag={site.pin.tag} commitShort={site.pin.commitShort} />
  </body>
</html>

<style is:global>
  /* El wordmark y `main:focus` son compartidos: viven en src/styles/global.css */
  .folio-wrap {
    display: grid;
    min-height: 0;
    min-width: 0;
  }
</style>
