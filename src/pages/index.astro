---
import EvidenceState from "../components/EvidenceState.astro";
import QuestionEntry from "../components/QuestionEntry.astro";
import Base from "../layouts/Base.astro";
import { loadSite } from "../lib/site.ts";

const site = loadSite(process.cwd());
const ui = site.ui;
const shapeOf = (state: string): string =>
  state === "INSUFFICIENT_EVIDENCE"
    ? ui("shape_insufficient")
    : state === "OBSERVED_IN_SOURCE"
      ? ui("shape_observed")
      : state === "REFUTED_WITHIN_SCOPE"
        ? ui("shape_refuted")
        : state === "NOT_IDENTIFIABLE"
          ? ui("shape_not_identifiable")
          : state === "BLOCKED_BY_DESIGN"
            ? ui("shape_blocked")
            : state === "OUTSIDE_LAB_A"
              ? ui("shape_open")
              : ui("layer_question");
---

<Base title={`${ui("brand_wordmark")} · ${ui("home_kicker")}`} description={ui("home_lede")}>
  <div class="wrap home">
    <header class="hero">
      <p class="kicker">{ui("home_kicker")}</p>
      <h1>{ui("brand_wordmark")}</h1>
      <p class="lede">{ui("home_lede")}</p>
      <p class="cta">
        <a href="/explorar">{ui("home_cta_questions")}</a>
        <a href="/hallazgos">{ui("home_cta_findings")}</a>
      </p>
    </header>

    <section class="band" aria-labelledby="overview-h">
      <h2 id="overview-h">{ui("home_overview_heading")}</h2>
      <p>{ui("home_overview_lede")}</p>
      <p>{ui("home_limits_lede")}</p>
      <ul class="counts">
        {site.counts.map((c) => (
          <li>
            {c.label}
            <span class="mono" data-num="count">
              {c.value}
            </span>
          </li>
        ))}
      </ul>
    </section>

    <section class="band" aria-labelledby="featured-h" data-featured="true">
      <h2 id="featured-h">{ui("home_featured_heading")}</h2>
      <p>{ui("home_featured_lede")}</p>
      <div class="list">
        {site.featured.map((q) => (
          <QuestionEntry q={q} kicker={ui("featured_kicker")} ui={ui} />
        ))}
      </div>
    </section>

    <section class="band" aria-labelledby="rest-h" data-remaining="true">
      <h2 id="rest-h">{ui("home_remaining_heading")}</h2>
      <p>{ui("home_remaining_lede")}</p>
      <p class="note">{ui("regime_c_note")}</p>
      <div class="list">
        {site.remaining.map((q) => (
          <QuestionEntry q={q} kicker={ui("minimal_kicker")} ui={ui} dense />
        ))}
      </div>
    </section>

    <section class="band" aria-labelledby="status-h">
      <h2 id="status-h">{ui("home_status_heading")}</h2>
      <p>{ui("home_status_lede")}</p>
      <ul class="states">
        {site.questionResolutions.map((s) => (
          <li data-state={s.state}>
            <EvidenceState state={s.state} label={s.label} description={shapeOf(s.state)} />
            <span class="mono" data-num="count">
              {s.n}
            </span>
          </li>
        ))}
      </ul>
    </section>

    <section class="band" aria-labelledby="method-h">
      <h2 id="method-h">{ui("home_method_heading")}</h2>
      <p>{ui("home_method_lede")}</p>
      <p>
        <a href="/metodo">{ui("nav_method")}</a>
      </p>
    </section>

    <section class="band" aria-labelledby="gov-h">
      <h2 id="gov-h">{ui("home_governance_heading")}</h2>
      <p>{ui("home_governance_lede")}</p>
      <ul class="ids">
        {site.governance.map((g) => (
          <li data-relation-id={g.id} data-relation-category="GOVERNANCE_REQUIRED">
            <a href={`/limites#${g.id}`}>
              <span class="mono" data-num="id">
                {g.id}
              </span>
            </a>
          </li>
        ))}
      </ul>
    </section>

    <section class="band" aria-labelledby="close-h">
      <h2 id="close-h">{ui("home_closure_heading")}</h2>
      <p>{ui("home_closure_lede")}</p>
      <p>{ui("versions_closed")}</p>
      <p class="mono">
        <span data-num="hash">{site.pin.tag}</span>
        <span data-num="hash">{site.pin.commit}</span>
      </p>
      <p>
        <a href="/versiones">{ui("footer_versions")}</a>
      </p>
    </section>

    <section class="band legal" aria-labelledby="legal-h">
      <h2 id="legal-h">{ui("home_legal_heading")}</h2>
      <p>{ui("legal_scope")}</p>
      <p>{ui("legal_states")}</p>
      <p>
        <a href="/sobre#aviso">{ui("nav_about")}</a>
      </p>
    </section>
  </div>
</Base>

<style>
  .home {
    padding-bottom: var(--space-10);
  }
  .hero {
    padding-block: var(--space-9) var(--space-8);
    max-width: 28rem;
  }
  .kicker {
    font: 500 var(--fs-label) / 1.4 var(--sans);
    color: var(--graphite);
  }
  h1 {
    margin-top: var(--space-4);
    font: 300 var(--fs-question) / var(--lh-tight) var(--serif);
    letter-spacing: -0.018em;
  }
  .lede,
  .band > p {
    margin-top: var(--space-5);
    font: 400 var(--fs-sans-lg) / var(--lh-body) var(--sans);
    color: var(--graphite);
    max-width: var(--measure-prose);
  }
  .cta {
    margin-top: var(--space-6);
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4) var(--space-6);
  }
  .cta a,
  .band a {
    font: 500 var(--fs-label) / 1.4 var(--sans);
    text-underline-offset: 0.2em;
  }
  .band {
    padding-block: var(--space-8);
    border-top: var(--rule) solid var(--hair);
  }
  .band h2 {
    font: 300 var(--fs-serif-xl) / var(--lh-tight) var(--serif);
    letter-spacing: -0.014em;
    max-width: 22ch;
  }
  .counts {
    margin-top: var(--space-6);
    display: grid;
    gap: var(--space-3);
    max-width: 36rem;
  }
  .counts li {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 3.5rem;
    gap: var(--space-4);
    align-items: baseline;
    font: 400 var(--fs-small) / var(--lh-body) var(--sans);
  }
  .note {
    font: italic 300 var(--fs-serif-sm) / var(--lh-serif) var(--serif) !important;
    color: var(--ink) !important;
  }
  .states {
    margin-top: var(--space-6);
    display: grid;
    gap: var(--space-5);
  }
  .states li {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    align-items: center;
  }
  .ids {
    margin-top: var(--space-5);
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3) var(--space-5);
  }
  .legal p {
    max-width: var(--measure-prose);
  }
</style>
