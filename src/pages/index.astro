---
import Caratula from "../components/Caratula.astro";
import Registro from "../components/Registro.astro";
import Shell from "../layouts/Shell.astro";
import { loadRegistro } from "../lib/registro.ts";

/** `/` → Registro + carátula del Folio (sin pregunta seleccionada). */
const registro = loadRegistro(process.cwd());
const ui = registro.ui;
---

<Shell
  title={`${ui("brand_wordmark")} · ${ui("home_kicker")}`}
  description={ui("home_lede")}
  view="registro"
>
  <Registro slot="registro" registro={registro} current={null} />
  <Caratula registro={registro} />
</Shell>
