---
import HowItWorks from "../components/HowItWorks.astro";
import QuestionRow from "../components/QuestionRow.astro";
import Base from "../layouts/Base.astro";
import { loadSite } from "../lib/site.ts";

/**
 * Home (WEB3-D1): la puerta de entrada, no un resumen del corpus. Cinco bloques, en el orden en que una persona se
 * hace las preguntas: qué es ALETHEIA → qué puedo explorar → cómo llega a un resultado → qué clase de proyecto es
 * → dónde miro los límites. Cada página tiene una función: /explorar descubre, la ficha explica, /limites y
 * /metodo profundizan, /versiones registra. La Home no repite nada de eso.
 *
 * Los IDs de Figure del recorrido son la ÚNICA cifra que interviene: el valor lo emite `FigureValue` desde el
 * artefacto generado; si un ID deja de ser una Figure ELIGIBLE de esa pregunta, el build falla.
 */
const site = loadSite(process.cwd());
const ui = site.ui;
const WALKTHROUGH = {
  qid: "LAB-Q-0005",
  figureIds: [
    "fig.LAB-CLM-0006.nominal_growth",
    "fig.LAB-CLM-0006.real_growth",
    "fig.LAB-CLM-0006.gap",
  ],
};
---

<Base
  title={`${ui("brand_wordmark")} · ${ui("home_kicker")}`}
  description={ui("home_hero_lede")}
  pin={false}
>
  <div class="home">
    <div class="wrap">
      <header class="hero">
        <h1>{ui("brand_wordmark")}</h1>
        <p class="hero__l">{ui("home_hero_lede")}</p>
        <p class="hero__n">{ui("home_hero_note")}</p>
        <p class="cta">
          <a class="cta__1" href="/explorar">
            {ui("home_cta_explore")}
          </a>
          <a class="cta__2" href="#como-llegamos">
            {ui("home_cta_how")}
          </a>
        </p>
      </header>

      <section class="band" aria-labelledby="ex-h" data-featured="true">
        <h2 id="ex-h">{ui("home_explore_heading")}</h2>
        <p class="lede">{ui("home_explore_lede")}</p>
        <ol class="rows">
          {site.featured.map((q) => (
            <QuestionRow q={q} ui={ui} variant="home" prefix="home" />
          ))}
        </ol>
        <p class="more">
          <a href="/explorar">{ui("home_explore_all")}</a>
        </p>
      </section>
    </div>

    <HowItWorks qid={WALKTHROUGH.qid} figureIds={WALKTHROUGH.figureIds} />

    <div class="wrap">
      <section class="band about" aria-labelledby="ab-h">
        <h2 id="ab-h">{ui("home_about_heading")}</h2>
        <dl class="about__l">
          <div>
            <dt>{ui("home_is_heading")}</dt>
            <dd>{ui("home_is_text")}</dd>
          </div>
          <div>
            <dt>{ui("home_isnot_heading")}</dt>
            <dd>{ui("home_isnot_text")}</dd>
          </div>
          <div>
            <dt>{ui("home_state_heading")}</dt>
            <dd>{ui("home_state_text")}</dd>
          </div>
        </dl>
      </section>

      <div class="band close">
        <ul class="close__l">
          <li>
            <a href="/limites">{ui("nav_limits")}</a>
            <p>{ui("home_close_limits")}</p>
          </li>
          <li>
            <a href="/metodo">{ui("nav_method")}</a>
            <p>{ui("home_close_method")}</p>
          </li>
        </ul>
      </div>
    </div>
  </div>
</Base>

<style>
  .home {
    padding-bottom: var(--space-8);
  }
  .hero {
    padding-block: var(--space-8) var(--space-7);
    max-width: 40rem;
  }
  h1 {
    font: 300 var(--fs-question) / var(--lh-tight) var(--serif);
    letter-spacing: -0.018em;
  }
  .hero__l {
    margin-top: var(--space-4);
    font: 300 var(--fs-serif-md) / var(--lh-serif) var(--serif);
    letter-spacing: var(--tracking-serif);
    max-width: 30ch;
  }
  .hero__n {
    margin-top: var(--space-4);
    font: 400 var(--fs-base) / var(--lh-body) var(--sans);
    color: var(--graphite);
    max-width: var(--measure-prose);
  }
  .cta {
    margin-top: var(--space-6);
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4) var(--space-6);
    align-items: baseline;
  }
  .cta a {
    font: 500 var(--fs-small) / 1.4 var(--sans);
    text-underline-offset: 0.25em;
  }
  .cta__1 {
    padding-block: var(--space-2);
    border-bottom: 2px solid var(--ink);
    text-decoration: none;
  }
  .band {
    padding-block: var(--space-8);
    border-top: var(--rule) solid var(--hair);
  }
  .band h2 {
    font: 300 var(--fs-serif-xl) / var(--lh-tight) var(--serif);
    letter-spacing: -0.014em;
    max-width: 22ch;
  }
  .lede {
    margin-top: var(--space-4);
    font: 400 var(--fs-sans-lg) / var(--lh-body) var(--sans);
    color: var(--graphite);
    max-width: var(--measure-prose);
  }
  .rows {
    margin-top: var(--space-6);
    border-top: var(--rule) solid var(--hair);
  }
  .more {
    margin-top: var(--space-5);
  }
  .more a,
  .close a {
    font: 500 var(--fs-label) / 1.4 var(--sans);
    text-underline-offset: 0.2em;
  }
  .about__l {
    margin-top: var(--space-6);
    display: grid;
    gap: var(--space-5);
    max-width: 52rem;
  }
  .about__l > div {
    display: grid;
    gap: var(--space-2);
  }
  .about__l dt {
    font: 500 var(--fs-label) / 1.4 var(--sans);
    color: var(--graphite);
  }
  .about__l dd {
    margin: 0;
    font: 400 var(--fs-serif-sm) / var(--lh-serif) var(--serif);
    max-width: 48ch;
  }
  .close {
    padding-bottom: 0;
  }
  .close__l {
    display: grid;
    gap: var(--space-6);
  }
  .close__l p {
    margin-top: var(--space-2);
    font: 400 var(--fs-base) / var(--lh-body) var(--sans);
    color: var(--graphite);
    max-width: var(--measure-prose);
  }
  @media (min-width: 64rem) {
    .about__l > div {
      grid-template-columns: 12rem minmax(0, 1fr);
      column-gap: var(--space-6);
      align-items: baseline;
    }
    .close__l {
      grid-template-columns: 1fr 1fr;
      column-gap: var(--space-7);
    }
  }
</style>
