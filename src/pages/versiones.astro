---
import DocPanel from "../components/DocPanel.astro";
import Registro from "../components/Registro.astro";
import Shell from "../layouts/Shell.astro";
import { loadRegistro } from "../lib/registro.ts";
import { loadSite } from "../lib/site.ts";

const site = loadSite(process.cwd());
const registro = loadRegistro(process.cwd());
const ui = site.ui;
---

<Shell
  title={`${ui("versions_heading")} · ${ui("brand_wordmark")}`}
  description={ui("versions_lede")}
  view="doc"
>
  <Registro slot="registro" registro={registro} current={null} />
  <DocPanel ui={ui} heading={ui("versions_heading")} lede={ui("versions_lede")}>
    <section class="doc__sec">
      <h2 class="doc__h">{ui("versions_labor")}</h2>
      <p class="doc__p">{ui("versions_closed")}</p>
      <dl class="doc__dl">
        <div>
          <dt>{ui("prov_module")}</dt>
          <dd class="mono">
            {site.pin.repoId} <span data-num="version">{site.pin.version}</span>
          </dd>
        </div>
        <div>
          <dt>{ui("prov_tag")}</dt>
          <dd class="mono">
            <span data-num="hash">{site.pin.tag}</span>
          </dd>
        </div>
        <div>
          <dt>{ui("prov_commit")}</dt>
          <dd class="mono">
            <span data-num="hash">{site.pin.commit}</span>
          </dd>
        </div>
      </dl>
    </section>
    <section class="doc__sec">
      <h2 class="doc__h">{ui("versions_v1")}</h2>
      <p class="doc__p">{ui("versions_closed")}</p>
      <p class="doc__p">{ui("versions_web")}</p>
    </section>
  </DocPanel>
</Shell>
