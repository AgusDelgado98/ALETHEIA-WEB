---
import QuestionRow from "../components/QuestionRow.astro";
import Base from "../layouts/Base.astro";
import { REGIMES, regimeGloss, regimeLabel } from "../lib/explore.ts";
import { loadQuestionMap } from "../lib/map.ts";

/**
 * /explorar (WEB3-D1): el centro del sitio. Las 18 preguntas se ven sin interacción, con su estado (forma +
 * texto), su régimen, su profundidad editorial y su tipo de resultado. Agrupadas por régimen (un dato del corpus:
 * no se inventan áreas temáticas). «Lectura completa» solo indica más desarrollo editorial, no más jerarquía.
 *
 * El filtro por estado es una mejora progresiva en CSS puro (`:has()`): todas las filas permanecen en el DOM, sin
 * filtro se ven las 18 y, sin CSS o sin `:has()`, el control ni aparece.
 */
const map = loadQuestionMap(process.cwd());
const ui = map.ui;
const STATES = [
  "OBSERVED_IN_SOURCE",
  "REFUTED_WITHIN_SCOPE",
  "INSUFFICIENT_EVIDENCE",
  "NOT_IDENTIFIABLE",
  "BLOCKED_BY_DESIGN",
  "OUTSIDE_LAB_A",
] as const;
const stateOptions = STATES.flatMap((s) => {
  const q = map.questions.find((x) => x.resolution === s);
  return q === undefined ? [] : [{ state: s, label: q.resolutionLabel }];
});
---

<Base title={`${ui("explore_heading")} · ${ui("brand_wordmark")}`} description={ui("explore_lede")}>
  <div class="wrap ex">
    <header class="ex__h">
      <h1>{ui("explore_heading")}</h1>
      <p class="ex__l">{ui("explore_lede")}</p>
      <p class="ex__n">{ui("explore_depth_note")}</p>
      <p class="ex__full">
        <a href="/hallazgos">{ui("explore_full_link")}</a>
      </p>
    </header>

    <div class="ex__body">
      <input class="sr-only" type="radio" name="estado" id="f-all" checked />
      {stateOptions.map((o) => (
        <input class="sr-only" type="radio" name="estado" id={`f-${o.state}`} />
      ))}
      <fieldset class="ex__f">
        <legend>{ui("explore_filter")}</legend>
        <ul>
          <li>
            <label for="f-all">{ui("explore_filter_all")}</label>
          </li>
          {stateOptions.map((o) => (
            <li>
              <label for={`f-${o.state}`}>{o.label}</label>
            </li>
          ))}
        </ul>
      </fieldset>

      {REGIMES.map((r) => {
        const qs = map.questions.filter((q) => q.regime === r);
        return (
          <section class="grp" aria-labelledby={`reg-${r}`} data-regime-group={r}>
            <h2 id={`reg-${r}`}>
              {ui("map_regime")} <span>{r}</span>
              <span aria-hidden="true"> · </span>
              <span>{regimeLabel(ui, r)}</span>
            </h2>
            <p class="grp__g">{regimeGloss(ui, r)}</p>
            <ol class="rows">
              {qs.map((q) => (
                <QuestionRow q={q} ui={ui} variant="explore" prefix="ex" />
              ))}
            </ol>
          </section>
        );
      })}
    </div>
  </div>
</Base>

<style>
  .ex {
    padding-bottom: var(--space-9);
  }
  .ex__h {
    padding-block: var(--space-8) var(--space-6);
    max-width: 44rem;
  }
  h1 {
    font: 300 var(--fs-question) / var(--lh-tight) var(--serif);
    letter-spacing: -0.018em;
  }
  .ex__l {
    margin-top: var(--space-4);
    font: 300 var(--fs-serif-md) / var(--lh-serif) var(--serif);
    letter-spacing: var(--tracking-serif);
    max-width: 34ch;
  }
  .ex__n {
    margin-top: var(--space-4);
    font: 400 var(--fs-small) / var(--lh-body) var(--sans);
    color: var(--graphite);
    max-width: var(--measure-prose);
  }
  .ex__full {
    margin-top: var(--space-4);
  }
  .ex__full a {
    font: 500 var(--fs-label) / 1.4 var(--sans);
    text-underline-offset: 0.2em;
  }
  .grp {
    padding-block: var(--space-7) 0;
  }
  .grp h2 {
    font: 300 var(--fs-serif-lg) / var(--lh-tight) var(--serif);
    letter-spacing: -0.014em;
    max-width: 30ch;
  }
  .grp__g {
    margin-top: var(--space-3);
    font: 400 var(--fs-small) / var(--lh-body) var(--sans);
    color: var(--graphite);
    max-width: var(--measure-prose);
  }
  .rows {
    margin-top: var(--space-5);
    border-top: var(--rule) solid var(--hair);
  }

  /* Filtro por estado: solo se muestra si el navegador soporta :has(); nunca oculta contenido por defecto. */
  .ex__f {
    display: none;
    margin: 0 0 var(--space-4);
    padding: 0;
    border: 0;
    min-width: 0;
  }
  .ex__f legend {
    padding: 0;
    font: 400 var(--fs-label) / 1.4 var(--sans);
    color: var(--graphite);
  }
  .ex__f ul {
    margin-top: var(--space-2);
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-4);
  }
  .ex__f label {
    display: inline-block;
    padding-block: var(--space-2);
    border-bottom: var(--rule) solid var(--hair-2);
    font: 500 var(--fs-small) / 1.3 var(--sans);
    color: var(--graphite);
    cursor: pointer;
  }
  @supports selector(:has(*)) {
    .ex__f {
      display: block;
    }
    .ex__body:has(#f-all:checked) label[for="f-all"],
    .ex__body:has(#f-OBSERVED_IN_SOURCE:checked) label[for="f-OBSERVED_IN_SOURCE"],
    .ex__body:has(#f-REFUTED_WITHIN_SCOPE:checked) label[for="f-REFUTED_WITHIN_SCOPE"],
    .ex__body:has(#f-INSUFFICIENT_EVIDENCE:checked) label[for="f-INSUFFICIENT_EVIDENCE"],
    .ex__body:has(#f-NOT_IDENTIFIABLE:checked) label[for="f-NOT_IDENTIFIABLE"],
    .ex__body:has(#f-BLOCKED_BY_DESIGN:checked) label[for="f-BLOCKED_BY_DESIGN"],
    .ex__body:has(#f-OUTSIDE_LAB_A:checked) label[for="f-OUTSIDE_LAB_A"] {
      color: var(--ink);
      font-weight: 600;
      border-bottom: 3px solid var(--ink);
    }
    .ex__body:has(#f-all:focus-visible) label[for="f-all"],
    .ex__body:has(#f-OBSERVED_IN_SOURCE:focus-visible) label[for="f-OBSERVED_IN_SOURCE"],
    .ex__body:has(#f-REFUTED_WITHIN_SCOPE:focus-visible) label[for="f-REFUTED_WITHIN_SCOPE"],
    .ex__body:has(#f-INSUFFICIENT_EVIDENCE:focus-visible) label[for="f-INSUFFICIENT_EVIDENCE"],
    .ex__body:has(#f-NOT_IDENTIFIABLE:focus-visible) label[for="f-NOT_IDENTIFIABLE"],
    .ex__body:has(#f-BLOCKED_BY_DESIGN:focus-visible) label[for="f-BLOCKED_BY_DESIGN"],
    .ex__body:has(#f-OUTSIDE_LAB_A:focus-visible) label[for="f-OUTSIDE_LAB_A"] {
      outline: var(--focus);
      outline-offset: var(--focus-offset);
    }
    .ex__body:has(#f-OBSERVED_IN_SOURCE:checked)
      :global(.row:not([data-question-resolution="OBSERVED_IN_SOURCE"])),
    .ex__body:has(#f-REFUTED_WITHIN_SCOPE:checked)
      :global(.row:not([data-question-resolution="REFUTED_WITHIN_SCOPE"])),
    .ex__body:has(#f-INSUFFICIENT_EVIDENCE:checked)
      :global(.row:not([data-question-resolution="INSUFFICIENT_EVIDENCE"])),
    .ex__body:has(#f-NOT_IDENTIFIABLE:checked)
      :global(.row:not([data-question-resolution="NOT_IDENTIFIABLE"])),
    .ex__body:has(#f-BLOCKED_BY_DESIGN:checked)
      :global(.row:not([data-question-resolution="BLOCKED_BY_DESIGN"])),
    .ex__body:has(#f-OUTSIDE_LAB_A:checked)
      :global(.row:not([data-question-resolution="OUTSIDE_LAB_A"])) {
      display: none;
    }
    .ex__body:has(#f-OBSERVED_IN_SOURCE:checked)
      .grp:not(:has(:global(.row[data-question-resolution="OBSERVED_IN_SOURCE"]))),
    .ex__body:has(#f-REFUTED_WITHIN_SCOPE:checked)
      .grp:not(:has(:global(.row[data-question-resolution="REFUTED_WITHIN_SCOPE"]))),
    .ex__body:has(#f-INSUFFICIENT_EVIDENCE:checked)
      .grp:not(:has(:global(.row[data-question-resolution="INSUFFICIENT_EVIDENCE"]))),
    .ex__body:has(#f-NOT_IDENTIFIABLE:checked)
      .grp:not(:has(:global(.row[data-question-resolution="NOT_IDENTIFIABLE"]))),
    .ex__body:has(#f-BLOCKED_BY_DESIGN:checked)
      .grp:not(:has(:global(.row[data-question-resolution="BLOCKED_BY_DESIGN"]))),
    .ex__body:has(#f-OUTSIDE_LAB_A:checked)
      .grp:not(:has(:global(.row[data-question-resolution="OUTSIDE_LAB_A"]))) {
      display: none;
    }
  }
</style>
