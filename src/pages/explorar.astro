---
import DocPanel from "../components/DocPanel.astro";
import Registro from "../components/Registro.astro";
import StateMark from "../components/StateMark.astro";
import Shell from "../layouts/Shell.astro";
import { loadQuestionMap } from "../lib/map.ts";
import { loadRegistro } from "../lib/registro.ts";

/** Explorar: las 18 preguntas completas con su resolución y sus afirmaciones, agrupadas por régimen. */
const map = loadQuestionMap(process.cwd());
const registro = loadRegistro(process.cwd());
const ui = map.ui;
const regimes = [...new Set(map.questions.map((q) => q.regime))];
---

<Shell
  title={`${ui("map_heading")} · ${ui("brand_wordmark")}`}
  description={ui("map_lede")}
  view="doc"
>
  <Registro slot="registro" registro={registro} current={null} />
  <DocPanel ui={ui} heading={ui("map_heading")} kicker={ui("map_kicker")} lede={ui("map_lede")}>
    <div class="doc__notes">
      <p>{ui("map_legend")}</p>
      <p>{ui("regime_c_note")}</p>
    </div>
    {regimes.map((regime) => (
      <section class="doc__sec">
        <h2 class="doc__h" id={`map-reg-${regime}`}>
          {ui("map_regime")} <span>{regime}</span>
        </h2>
        <ol class="mapl">
          {map.questions
            .filter((q) => q.regime === regime)
            .map((q) => (
              <li
                data-question-id={q.id}
                data-question-resolution={q.resolution}
                data-regime={q.regime}
              >
                <span class="mono" data-num="id">
                  {q.id.replace(/^LAB-Q-/, "")}
                </span>
                <a class="mapl__q" href={q.href}>
                  {q.text}
                </a>
                <span class="mapl__st">
                  <span class="mapl__row">
                    <StateMark state={q.resolution} uid={`map-${q.id}`} />
                    <span class="sr-only">{ui("layer_question")}: </span>
                    <span>{q.resolutionLabel}</span>
                  </span>
                  {q.claims.length === 0 ? (
                    <span class="mapl__zero">{ui("no_claim_trail")}</span>
                  ) : (
                    q.claims.map((cl) => (
                      <span class="mapl__row" data-claim-id={cl.id} data-claim-state={cl.state}>
                        <StateMark state={cl.state} uid={`map-${cl.id}`} />
                        <span class="mono" data-num="id">
                          {cl.id}
                        </span>
                        <span>{cl.label}</span>
                      </span>
                    ))
                  )}
                </span>
              </li>
            ))}
        </ol>
      </section>
    ))}
  </DocPanel>
</Shell>
