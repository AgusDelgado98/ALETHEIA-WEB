---
import DocPanel from "../components/DocPanel.astro";
import Registro from "../components/Registro.astro";
import StateMark from "../components/StateMark.astro";
import Shell from "../layouts/Shell.astro";
import { loadRegistro } from "../lib/registro.ts";
import { isDocumentaryObserved, loadSite } from "../lib/site.ts";

/** Hallazgos: las cinco fichas con lectura completa. El régimen C no entra; sigue en Explorar y en Límites. */
const site = loadSite(process.cwd());
const registro = loadRegistro(process.cwd());
const ui = site.ui;
---

<Shell
  title={`${ui("findings_heading")} · ${ui("brand_wordmark")}`}
  description={ui("findings_lede")}
  view="doc"
>
  <Registro slot="registro" registro={registro} current={null} />
  <DocPanel
    ui={ui}
    heading={ui("findings_heading")}
    kicker={ui("featured_kicker")}
    lede={ui("findings_lede")}
  >
    <ol class="mapl" data-featured="true">
      {site.featured.map((q) => (
        <li
          data-finding-question={q.id}
          data-question-resolution={q.resolution}
          data-regime={q.regime}
        >
          <span class="mono" data-num="id">
            {q.id.replace(/^LAB-Q-/, "")}
          </span>
          <a class="mapl__q" href={q.href}>
            {q.text}
          </a>
          <span class="mapl__st">
            <span class="mapl__row">
              <StateMark state={q.resolution} uid={`find-${q.id}`} />
              <span class="sr-only">{ui("layer_question")}: </span>
              <span>{q.resolutionLabel}</span>
            </span>
            {q.claims.map((cl) => (
              <span class="mapl__row" data-claim-id={cl.id} data-claim-state={cl.state}>
                <StateMark state={cl.state} uid={`find-${cl.id}`} />
                <span class="mono" data-num="id">
                  {cl.id}
                </span>
                <span>{cl.label}</span>
                {isDocumentaryObserved(cl.kind, cl.state) && (
                  <span class="mapl__q2">{ui("qualifier_documentary")}</span>
                )}
              </span>
            ))}
          </span>
        </li>
      ))}
    </ol>
  </DocPanel>
</Shell>
