---
import CanonicalCite from "../components/CanonicalCite.astro";
import DocPanel from "../components/DocPanel.astro";
import Registro from "../components/Registro.astro";
import SegmentText from "../components/SegmentText.astro";
import Shell from "../layouts/Shell.astro";
import { loadRegistro } from "../lib/registro.ts";
import { loadSite } from "../lib/site.ts";

const site = loadSite(process.cwd());
const registro = loadRegistro(process.cwd());
const ui = site.ui;
---

<Shell
  title={`${ui("limits_heading")} · ${ui("brand_wordmark")}`}
  description={ui("limits_lede")}
  view="doc"
>
  <Registro slot="registro" registro={registro} current={null} />
  <DocPanel ui={ui} heading={ui("limits_heading")} lede={ui("limits_lede")}>
    <section class="doc__sec" aria-labelledby="gr-h">
      <h2 class="doc__h" id="gr-h">
        {ui("limits_gr_heading")}
      </h2>
      <p class="doc__p">{ui("limits_gr_intro")}</p>
      <ol class="rows">
        {site.governance.map((g) => (
          <li id={g.id} data-relation-id={g.id} data-relation-category="GOVERNANCE_REQUIRED">
            <p class="idrow">
              <span class="mono" data-num="id">
                {g.id}
              </span>
              <span>{ui("limits_unresolved")}</span>
            </p>
            <h3>
              <SegmentText parts={g.titlePublic} />
            </h3>
            <CanonicalCite label={ui("canonical_cite")} parts={g.titleParts} />
            <p class="lbl">{ui("limits_inference")}</p>
            <p>
              <SegmentText parts={g.inferencePublic} />
            </p>
            <CanonicalCite label={ui("canonical_cite")} parts={g.inference} />
            <p class="lbl">{ui("limits_must_not")}</p>
            <p>
              <SegmentText parts={g.reasonPublic} />
            </p>
            <CanonicalCite label={ui("canonical_cite")} parts={g.reason} />
          </li>
        ))}
      </ol>
    </section>

    <section class="doc__sec" aria-labelledby="keep-h">
      <h2 class="doc__h" id="keep-h">
        {ui("limits_keep_heading")}
      </h2>
      <p class="doc__p">{ui("limits_keep_intro")}</p>
      <p class="doc__p doc__p--note">{ui("regime_c_note")}</p>
      <ol class="rows">
        {site.preserved.map((k) => (
          <li
            id={k.id}
            data-keep-id={k.id}
            data-regime={k.regime}
            data-keep-question={k.questionId}
          >
            <p class="idrow">
              <span class="mono" data-num="id">
                {k.id}
              </span>
              <span>
                {ui("map_regime")} <span>{k.regime}</span>
              </span>
              <span class="mono" data-num="id">
                {k.category}
              </span>
            </p>
            <p>
              <a href={k.href}>
                {ui("question_kicker")}{" "}
                <span class="mono" data-num="id">
                  {k.questionId}
                </span>
              </a>
            </p>
            <p class="lbl">{ui("limits_must_not")}</p>
            <p>
              <SegmentText parts={k.mustNotPublic} />
            </p>
            <CanonicalCite label={ui("canonical_cite")} parts={k.mustNot} />
          </li>
        ))}
      </ol>
    </section>
  </DocPanel>
</Shell>
