---
import Folio from "../../../components/Folio.astro";
import Registro from "../../../components/Registro.astro";
import Shell from "../../../layouts/Shell.astro";
import { loadRegistro, shapeKey } from "../../../lib/registro.ts";
import { plainText } from "../../../lib/render.ts";
import { isDocumentaryObserved, loadSite } from "../../../lib/site.ts";
import { availableQuestionIds, loadQuestionView, questionSlug } from "../../../lib/view.ts";

/**
 * Una ruta por cada pregunta del corpus (URL canónica sin cambios): el shell Registro + Folio con la pregunta
 * seleccionada. Las cinco fichas con lectura completa muestran su texto editorial; el resto, lo que el corpus expone.
 */
export function getStaticPaths() {
  return availableQuestionIds(process.cwd()).map((id) => ({
    params: { id: questionSlug(id) },
    props: { qid: id },
  }));
}
const { qid } = Astro.props;
const registro = loadRegistro(process.cwd());
const v = loadQuestionView(process.cwd(), qid);
const site = loadSite(process.cwd());
const ui = v.ui;
const regime = registro.groups.find((g) => g.rows.some((r) => r.id === qid))?.regime ?? "";
const shapeOf = (state: string): string => ui(shapeKey(state));
const claimIds = new Set(v.claims.map((cl) => cl.id));
const preserved = site.preserved.filter((k) => k.questionId === qid);
const governance = site.governance.filter((g) => g.claimIds.some((id) => claimIds.has(id)));
---

<Shell
  title={`${v.publicQuestion} · ${ui("brand_wordmark")}`}
  description={plainText(v.title)}
  ogDescription={`${v.state.questionLabel}. ${
    v.claims.some((cl) => isDocumentaryObserved(cl.kind, cl.state))
      ? ui("qualifier_documentary")
      : ui("legal_states")
  }`}
  view="folio"
>
  <Registro slot="registro" registro={registro} current={qid} />
  <Folio v={v} regime={regime} shapeOf={shapeOf} preserved={preserved} governance={governance} />
</Shell>
