---
import QuestionPicker from "../../../components/QuestionPicker.astro";
import SingleFolio from "../../../components/SingleFolio.astro";
import Focus from "../../../layouts/Focus.astro";
import { loadRegistro, PICKER_TOGGLE_ID, shapeKey } from "../../../lib/registro.ts";
import { plainText } from "../../../lib/render.ts";
import { isDocumentaryObserved } from "../../../lib/site.ts";
import { availableQuestionIds, loadQuestionView, questionSlug } from "../../../lib/view.ts";

/** Las 18 preguntas comparten la experiencia guiada; una ficha mínima muestra solo lo registrado. */
export function getStaticPaths() {
  return availableQuestionIds(process.cwd()).map((id) => ({
    params: { id: questionSlug(id) },
    props: { qid: id },
  }));
}

const { qid } = Astro.props;
const registro = loadRegistro(process.cwd());
const rows = registro.groups.flatMap((group) => group.rows);
const index = rows.findIndex((row) => row.id === qid);
const v = loadQuestionView(process.cwd(), qid);
const ui = v.ui;
const shapeOf = (state: string): string => ui(shapeKey(state));
const prevHref = index === 0 ? "/" : (rows[index - 1]?.href ?? "/");
const nextHref = index === rows.length - 1 ? "/cierre" : (rows[index + 1]?.href ?? "/cierre");
---

<Focus
  title={`${v.publicQuestion} · ${ui("brand_wordmark")}`}
  description={plainText(v.title)}
  ogDescription={`${v.state.questionLabel}. ${
    v.claims.some((claim) => isDocumentaryObserved(claim.kind, claim.state))
      ? ui("qualifier_documentary")
      : ui("legal_states")
  }`}
>
  <label slot="bar" for={PICKER_TOGGLE_ID} class="btn btn--ghost">
    {ui("single_change_question")}
  </label>
  <SingleFolio
    v={v}
    shapeOf={shapeOf}
    index={index + 1}
    total={rows.length}
    prevHref={prevHref}
    nextHref={nextHref}
  />
  <QuestionPicker slot="picker" registro={registro} current={qid} />
</Focus>
