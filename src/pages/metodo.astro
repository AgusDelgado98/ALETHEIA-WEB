---
import EvidenceState from "../components/EvidenceState.astro";
import Base from "../layouts/Base.astro";
import { loadSite } from "../lib/site.ts";

const site = loadSite(process.cwd());
const ui = site.ui;
const shapeOf = (state: string): string =>
  state === "INSUFFICIENT_EVIDENCE"
    ? ui("shape_insufficient")
    : state === "OBSERVED_IN_SOURCE"
      ? ui("shape_observed")
      : state === "REFUTED_WITHIN_SCOPE"
        ? ui("shape_refuted")
        : state === "NOT_IDENTIFIABLE"
          ? ui("shape_not_identifiable")
          : state === "BLOCKED_BY_DESIGN"
            ? ui("shape_blocked")
            : state === "OUTSIDE_LAB_A"
              ? ui("shape_open")
              : ui("layer_question");
---

<Base title={`${ui("method_heading")} · ${ui("brand_wordmark")}`} description={ui("method_lede")}>
  <div class="wrap page">
    <header class="ph">
      <h1>{ui("method_heading")}</h1>
      <p>{ui("method_lede")}</p>
    </header>
    <section>
      <h2>{ui("layer_question")}</h2>
      <p>{ui("method_two_layers")}</p>
      <ul class="states">
        {site.questionResolutions.map((s) => (
          <li>
            <EvidenceState state={s.state} label={s.label} description={shapeOf(s.state)} />
          </li>
        ))}
      </ul>
    </section>
    <section>
      <h2>{ui("layer_claim")}</h2>
      <p>{ui("method_observed")}</p>
      <ul class="states">
        {site.claimStates.map((s) => (
          <li>
            <EvidenceState state={s.state} label={s.label} description={shapeOf(s.state)} />
          </li>
        ))}
      </ul>
    </section>
    <section>
      <h2>{ui("provenance_summary")}</h2>
      <p>{ui("method_provenance")}</p>
      <p>{ui("method_no_new")}</p>
    </section>
  </div>
</Base>

<style>
  .page {
    padding-bottom: var(--space-10);
  }
  .ph {
    padding-block: var(--space-8) var(--space-6);
    max-width: var(--measure-prose);
  }
  h1 {
    font: 300 var(--fs-question) / var(--lh-tight) var(--serif);
    letter-spacing: -0.018em;
  }
  .ph p,
  section p {
    margin-top: var(--space-5);
    font: 400 var(--fs-sans-lg) / var(--lh-body) var(--sans);
    color: var(--graphite);
    max-width: var(--measure-prose);
  }
  section {
    padding-block: var(--space-8);
    border-top: var(--rule) solid var(--hair);
  }
  h2 {
    font: 300 var(--fs-serif-xl) / var(--lh-tight) var(--serif);
    letter-spacing: -0.014em;
    max-width: 22ch;
  }
  .states {
    margin-top: var(--space-6);
    display: grid;
    gap: var(--space-5);
  }
</style>
