---
import DocPanel from "../components/DocPanel.astro";
import Registro from "../components/Registro.astro";
import StateMark from "../components/StateMark.astro";
import Shell from "../layouts/Shell.astro";
import { loadRegistro, shapeKey } from "../lib/registro.ts";
import { loadSite } from "../lib/site.ts";

const site = loadSite(process.cwd());
const registro = loadRegistro(process.cwd());
const ui = site.ui;
---

<Shell
  title={`${ui("method_heading")} · ${ui("brand_wordmark")}`}
  description={ui("method_lede")}
  view="doc"
>
  <Registro slot="registro" registro={registro} current={null} />
  <DocPanel ui={ui} heading={ui("method_heading")} lede={ui("method_lede")}>
    <section class="doc__sec">
      <h2 class="doc__h">{ui("layer_question")}</h2>
      <p class="doc__p">{ui("method_two_layers")}</p>
      <ul class="stl">
        {site.questionResolutions.map((s) => (
          <li data-state={s.state}>
            <StateMark state={s.state} uid={`met-q-${s.state}`} />
            <span>{s.label}</span>
            <span class="sr-only">{ui(shapeKey(s.state))}</span>
          </li>
        ))}
      </ul>
    </section>
    <section class="doc__sec">
      <h2 class="doc__h">{ui("layer_claim")}</h2>
      <p class="doc__p">{ui("method_observed")}</p>
      <ul class="stl">
        {site.claimStates.map((s) => (
          <li data-state={s.state}>
            <StateMark state={s.state} uid={`met-c-${s.state}`} />
            <span>{s.label}</span>
            <span class="sr-only">{ui(shapeKey(s.state))}</span>
          </li>
        ))}
      </ul>
    </section>
    <section class="doc__sec">
      <h2 class="doc__h">{ui("provenance_summary")}</h2>
      <p class="doc__p">{ui("method_provenance")}</p>
      <p class="doc__p">{ui("method_no_new")}</p>
    </section>
  </DocPanel>
</Shell>
