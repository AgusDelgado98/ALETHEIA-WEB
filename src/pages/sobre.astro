---
import GuideDoc from "../components/GuideDoc.astro";
import Focus from "../layouts/Focus.astro";
import { loadSite } from "../lib/site.ts";

const site = loadSite(process.cwd());
const ui = site.ui;
// Identificadores de la licencia (no son prosa editorial): versión y URL oficial de CC BY-SA.
const CC_BY_SA_VERSION = "4.0";
const CC_BY_SA_URL = "https://creativecommons.org/licenses/by-sa/4.0/";
---

<Focus title={`${ui("about_heading")} · ${ui("brand_wordmark")}`} description={ui("about_what")}>
  <GuideDoc ui={ui} heading={ui("about_heading")} lede={ui("about_what")}>
    <section class="doc__sec">
      <p class="doc__p">{ui("about_independence")}</p>
      <p class="doc__p">{ui("about_a11y")}</p>
      <p class="doc__p">{ui("about_privacy")}</p>
    </section>
    <section class="doc__sec" id="aviso" aria-labelledby="legal-h">
      <h2 class="doc__h" id="legal-h">
        {ui("legal_heading")}
      </h2>
      <p class="doc__p">{ui("legal_scope")}</p>
      <p class="doc__p">{ui("legal_states")}</p>
      <p class="doc__p">{ui("legal_governance")}</p>
      <p class="doc__p">{ui("legal_frozen")}</p>
      <p class="doc__p">{ui("legal_not_advice")}</p>
    </section>
    <section class="doc__sec" id="atribuciones" aria-labelledby="attrib-h">
      <h2 class="doc__h" id="attrib-h">
        {ui("attrib_heading")}
      </h2>
      <p class="doc__p">
        {ui("attrib_cgi_a")} <span data-num="id">{CC_BY_SA_VERSION}</span>
        {" ("}
        <a href={CC_BY_SA_URL} rel="noopener noreferrer">
          <span data-num="id">{CC_BY_SA_URL}</span>
        </a>
        {ui("attrib_cgi_c")} <span data-num="id">{CC_BY_SA_VERSION}</span>
        {ui("attrib_cgi_d")}
      </p>
      <p class="doc__p">{ui("attrib_others")}</p>
    </section>
  </GuideDoc>
</Focus>
