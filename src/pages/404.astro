---
import DocPanel from "../components/DocPanel.astro";
import Registro from "../components/Registro.astro";
import Shell from "../layouts/Shell.astro";
import { loadRegistro } from "../lib/registro.ts";
import { loadUi } from "../lib/site.ts";

const ui = loadUi(process.cwd());
const registro = loadRegistro(process.cwd());
---

<Shell
  title={`${ui("not_found_heading")} · ${ui("brand_wordmark")}`}
  description={ui("not_found_lede")}
  robots="noindex"
  view="doc"
>
  <Registro slot="registro" registro={registro} current={null} />
  <DocPanel ui={ui} heading={ui("not_found_heading")} lede={ui("not_found_lede")} bare>
    <p class="doc__p">
      <a href="/">{ui("not_found_home")}</a>
    </p>
  </DocPanel>
</Shell>
